{
  "schemaVersion": 1,
  "id": "btanfc",
  "version": "${version}",
  "name": "BTA+NFC",
  "description": "Add things from NFC into BTA",
  "authors": [
    "Helinos",
    "NFC Team"
  ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/Helinos/BTA-NFC"
  },
  "icon": "icon.png",
  "license": "LGPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.helinos.btanfc.BTANFC"
    ],
    "beforeClientStart": [
      "net.helinos.btanfc.BTANFC"
    ],
    "recipesReady": [
      "net.helinos.btanfc.recipe.NFCRecipes"
    ],
    "initModels": [
      "net.helinos.btanfc.NFCModels"
    ],
    "afterBlockInit": [
      "net.helinos.btanfc.block.NFCBlocks"
    ],
    "afterItemInit": [
      "net.helinos.btanfc.block.NFCBlocks",
      "net.helinos.btanfc.item.NFCItems"
    ]
  },
  "mixins": [
    "btanfc.mixins.json"
  ],
  "depends": {
    "minecraft": "^7.2-beta",
    "fabricloader": ">=0.15.5"
  },
  "suggests": {}
}